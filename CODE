void tambahPengguna(const string& username, const string& password, const string& role) {
    daftarPengguna.push_back({username, password, role});
}

bool validasiPengguna(const string& username, const string& password, string& role) {
    for (const auto& pengguna : daftarPengguna) {
        if (pengguna.username == username && pengguna.password == password) {
            role = pengguna.role;
            return true;
        }
    }
    return false;
}

void registrasiPengguna() {
    string username, password, role;
    cout << "=== Registrasi Akun Sistem Manajemen Rumah Sakit ===" << endl;
    cout << "Username: ";
    cin >> username;
    cout << "Password: ";
    cin >> password;
    cout << "Role (admin/dokter/resepsionis): ";
    cin >> role;

    if (role != "admin" && role != "dokter" && role != "resepsionis") {
        cout << "Role kamu tidak valid. Harus admin, dokter, atau resepsionis." << endl;
        return;
    }

    for (const auto& pengguna : daftarPengguna) {
        if (pengguna.username == username) {
            cout << "Anda sudah terdaftar. Silakan coba lagi." << endl;
            return;
        }
    }

    tambahPengguna(username, password, role);
    cout << "Registrasi berhasil . Silakan login dengan username dan password Anda." << endl;
}


void tambahPasien(string namaLengkap, string nik, int umur, string tanggalLahir, string alamat, string noTelepon, string tujuanBerobat, string keluhan) {
