void tambahJadwalPerawatan(string namaPasien, string tanggal, string waktu, string deskripsi) {
    Pasien* temp = head;
    while(temp != NULL) {
        if(temp->nama == namaPasien) {
            Jadwal* jadwalBaru = new Jadwal();
            jadwalBaru->tanggal = tanggal;
            jadwalBaru->waktu = waktu;
            jadwalBaru->deskripsi = deskripsi;
            jadwalBaru->next = temp->jadwalHead;
            temp->jadwalHead = jadwalBaru;
            cout << "Jadwal perawatan untuk pasien " << namaPasien << " telah ditambahkan.\n";
            return;
        }
        temp = temp->next;
    }
    cout << "Pasien dengan nama " << namaPasien << " tidak ditemukan.\n";
}

void editJadwalPerawatan(string namaPasien) {
    Pasien* temp = head;
    while(temp != NULL) {
        if(temp->nama == namaPasien) {
            cout << "Masukkan tanggal jadwal yang ingin diedit (format: yyyy-mm-dd): ";
            string tanggal;
            cin.ignore();
            getline(cin, tanggal);
            Jadwal* jadwalTemp = temp->jadwalHead;
            while(jadwalTemp != NULL) {
                if(jadwalTemp->tanggal == tanggal) {
                    cout << "Masukkan tanggal baru : ";
                    string tanggalBaru;
                    getline(cin, tanggalBaru);
                    if (!tanggalBaru.empty()) {
                        jadwalTemp->tanggal = tanggalBaru;
                    }

                    cout << "Masukkan waktu baru: ";
                    string waktuBaru;
                    getline(cin, waktuBaru);
                    if (!waktuBaru.empty()) {
                        jadwalTemp->waktu = waktuBaru;
                    }

                    cout << "Masukkan deskripsi baru : ";
                    string deskripsiBaru;
                    getline(cin, deskripsiBaru);
                    if (!deskripsiBaru.empty()) {
                        jadwalTemp->deskripsi = deskripsiBaru;
                    }

                    cout << "Jadwal perawatan telah diperbarui.\n";
                    return;
                }
                jadwalTemp = jadwalTemp->next;
            }
            cout << "Jadwal dengan tanggal " << tanggal << " tidak ditemukan.\n";
            return;
        }
        temp = temp->next;
    }
    cout << "Pasien dengan nama " << namaPasien << " tidak ditemukan.\n";
}

void tampilkanJadwalPerawatan() {
    Pasien* temp = head;
    while(temp != NULL) {
        cout << "Jadwal perawatan untuk pasien " << temp->nama << ":\n";
        Jadwal* jadwalTemp = temp->jadwalHead;
        while(jadwalTemp != NULL) {
            cout << "Tanggal: " << jadwalTemp->tanggal << ", Waktu: " << jadwalTemp->waktu << ", Deskripsi: " << jadwalTemp->deskripsi << endl;
