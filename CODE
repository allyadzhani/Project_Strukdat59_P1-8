        temp = temp->next;
    }
    cout << "Pasien dengan nama " << nama << " tidak ditemukan.\n";
}

void hapusPasien(string nama) {
    if(head == NULL) {
        cout << "Daftar pasien kosong.\n";
        return;
    }
    if(head->nama == nama) {
        Pasien* temp = head;
        head = head->next;
        delete temp;
        cout << "Pasien dengan nama " << nama << " telah dihapus.\n";
        return;
    }
    Pasien* temp = head;
    while(temp->next != NULL) {
        if(temp->next->nama == nama) {
            Pasien* toDelete = temp->next;
            temp->next = temp->next->next;
            delete toDelete;
            cout << "Pasien dengan nama " << nama << " telah dihapus.\n";
            return;
        }
        temp = temp->next;
    }
    cout << "Pasien dengan nama " << nama << " tidak ditemukan.\n";
}

void simpanDataPasien(const string& filename) {
    ofstream file(filename);
    if (file.is_open()) {
        Pasien* temp = head;
        while (temp != NULL) {
            file << temp->nama << "," << temp->nik << "," << temp->umur << "," << temp->tanggalLahir << "," << temp->alamat << "," << temp->noTelepon << "," << temp->tujuanBerobat << "," << temp->keluhan << endl;

            Jadwal* jadwalTemp = temp->jadwalHead;
            while (jadwalTemp != nullptr) {
                file << "JADWAL," << jadwalTemp->tanggal << "," << jadwalTemp->waktu << "," << jadwalTemp->deskripsi << endl;
                jadwalTemp = jadwalTemp->next;
            }

            for (const auto& obat : temp->riwayatObat) {
                file << "OBAT," << obat.namaObat << "," << obat.efekObat << endl;
            }

            for (const auto& resep : temp->daftarResep) {
                file << "RESEP," << resep.namaObat << "," << resep.dosis << "," << resep.instruksi << endl;
            }

            temp = temp->next;
        }
        file.close();
        cout << "Data pasien telah disimpan ke dalam file " << filename << endl;
    } else {
        cout << "Gagal membuka file " << filename << endl;
    }
}

void muatDataPasien(const string& filename) {
    ifstream file(filename);
    if (file.is_open()) {
        string line;
        Pasien* pasienBaru = nullptr;
        while (getline(file, line)) {
            if (line.substr(0, 6) != "JADWAL" && line.substr(0, 4) != "OBAT" && line.substr(0, 5) != "RESEP") {
                pasienBaru = new Pasien();
                sscanf(line.c_str(), "%[^,],%[^,],%d,%[^,],%[^,],%[^,],%[^,],%[^\n]", pasienBaru->nama.c_str(), pasienBaru->nik.c_str(), &pasienBaru->umur, pasienBaru->tanggalLahir.c_str(), pasienBaru->alamat.c_str(), pasienBaru->noTelepon.c_str(), pasienBaru->tujuanBerobat.c_str(), pasienBaru->keluhan.c_str());
                pasienBaru->jadwalHead = nullptr;
                pasienBaru->next = head;
                head = pasienBaru;
            } else if (line.substr(0, 6) == "JADWAL") {
                Jadwal* jadwalBaru = new Jadwal();
                sscanf(line.c_str(), "JADWAL,%[^,],%[^,],%[^\n]", jadwalBaru->tanggal.c_str(), jadwalBaru->waktu.c_str(), jadwalBaru->deskripsi.c_str());
                jadwalBaru->next = pasienBaru->jadwalHead;
                pasienBaru->jadwalHead = jadwalBaru;
            } else if (line.substr(0, 4) == "OBAT") {
                Obat obatBaru;
                sscanf(line.c_str(), "OBAT,%[^,],%[^\n]", obatBaru.namaObat.c_str(), obatBaru.efekObat.c_str());
                pasienBaru->riwayatObat.push_back(obatBaru);
            } else if (line.substr(0, 5) == "RESEP") {
                Resep resepBaru;
                sscanf(line.c_str(), "RESEP,%[^,],%[^,],%[^\n]", resepBaru.namaObat.c_str(), resepBaru.dosis.c_str(), resepBaru.instruksi.c_str());
                pasienBaru->daftarResep.push_back(resepBaru);
            }
        }
        file.close();
        cout << "Data pasien telah dimuat dari file " << filename << endl;
    } else {
        cout << "Gagal membuka file " << filename << endl;
    }
}

