                    string namaLengkap, nik, tanggalLahir, alamat, noTelepon, tujuanBerobat, keluhan;
                    int umur;
                    cout << "Nama Lengkap: ";
                    getline(cin, namaLengkap);
                    cout << "NIK: ";
                    getline(cin, nik);
                    cout << "Umur: ";
                    cin >> umur;
                    cin.ignore();
                    cout << "Tanggal Lahir: ";
                    getline(cin, tanggalLahir);
                    cout << "Alamat: ";
                    getline(cin, alamat);
                    cout << "No Telepon: ";
                    getline(cin, noTelepon);
                    cout << "Tujuan Berobat (Umum/PoliGigi/THT): ";
                    getline(cin, tujuanBerobat);
                    cout << "Keluhan: ";
                    getline(cin, keluhan);

                    tambahPasien(namaLengkap, nik, umur, tanggalLahir, alamat, noTelepon, tujuanBerobat, keluhan);
                    cout << "Pasien atas nama " << namaLengkap << " berhasil ditambahkan." << endl;
                } else if (pilihan == 2) {
                    tampilkanPasien();
                } else if (pilihan == 3) {
                    tampilkanJadwalPerawatan();
                } else if (pilihan == 4) { 
                    string nama;
                    cout << "Masukkan nama pasien yang dicari: ";
                    getline(cin, nama);
                    cariPasien(nama);
                } else if (pilihan == 5) {
                    string filename;
                    cout << "Masukkan nama file untuk memuat data pasien: ";
                    getline(cin, filename);
                    muatDataPasien(filename);
                } else if (pilihan == 0) {
                    loggedIn = false;
                    cout << "Logout berhasil." << endl;
                } else {
                    cout << "Pilihan tidak valid. Silakan coba lagi." << endl;
                }
            } while (loggedIn);
        }
    }

    return 0;
}
